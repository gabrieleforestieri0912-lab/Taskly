{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "es2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "."
  },
  "include": ["main.ts", "preload.ts"],
  "exclude": ["node_modules"]
}
