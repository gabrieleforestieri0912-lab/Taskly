{
  "name": "taskly-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"npm run server\" \"next dev -p 3333\" \"wait-on http://localhost:3333 && electron .\"",
    "build": "next build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "start": "electron .",
    "server": "node -r ts-node/register/transpile-only server/index.ts",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@stripe/stripe-js": "^9.3.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/core": "^2.0.0",
    "@tiptap/extension-mention": "^2.0.0",
    "@tiptap/react": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "axios": "^1.6.7",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "framer-motion": "^11.0.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "mongoose": "^8.1.1",
    "next": "16.2.2",
    "nodemailer": "^6.9.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^6.22.0",
    "resend": "^4.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.taskly.desktop",
    "productName": "Taskly",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/taskly.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "next.config.mjs",
      "postcss.config.mjs",
      "tsconfig.json",
      ".next/**/*",
      "public/**/*",
      "server/**/*",
      ".env",
      "node_modules/**/*"
    ]
  }
}
