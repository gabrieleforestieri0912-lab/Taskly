{
  "name": "taskly-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Taskly — workspace di produttività: pagine, task, obiettivi, planner, trascrizioni",
  "author": "Taskly",
  "main": "main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"npm run server\" \"npm --prefix .. run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "start": "electron .",
    "server": "ts-node -T -P tsconfig.electron.json server/index.ts",
    "package": "npm run build && node package.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.taskly.desktop",
    "productName": "Taskly",
    "artifactName": "Taskly-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "../public/taskly.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "appconfig.json",
      "public/**/*",
      "server/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "web",
        "filter": ["**/*", "!.env*"]
      },
      {
        "from": "../.next/static",
        "to": "web/.next/static"
      },
      {
        "from": "../public",
        "to": "web/public"
      }
    ]
  }
}
